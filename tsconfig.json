{
    "include": [
        "node_modules/bc-stubs/bc/**/*.d.ts",
        "**/*.js",
        "**/*.ts"
    ],
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "allowJs": false,
        "removeComments": true,
        "sourceMap": true,
        "alwaysStrict": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "noEmit": true,
        "ignoreDeprecations": "6.0",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    }
}